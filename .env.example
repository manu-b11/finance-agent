POSTGRES_USER=finanzas
POSTGRES_PASSWORD=finanzas
POSTGRES_DB=finanzas
DATABASE_URL=postgresql+asyncpg://finanzas:finanzas@localhost:5432/finanzas
JWT_SECRET=cambia-este-secreto
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
CORS_ORIGINS=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=glm-5.3-flash
LLM_TIMEOUT_SECONDS=60
# Ollama Cloud necesita OLLAMA_API_KEY (https://ollama.com/settings/keys).
# Para Ollama local usa http://localhost:11434 y deja la clave vacía.
OLLAMA_NUM_CTX=8192
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_SECONDS=120
# Respaldo Qwen vía API compatible con OpenAI.
# OpenRouter: https://openrouter.ai/settings/keys
# Groq (alternativa): QWEN_BASE_URL=https://api.groq.com/openai/v1 y QWEN_MODEL=qwen/qwen3.8-27b
QWEN_BASE_URL=https://openrouter.ai/api/v1
QWEN_API_KEY=
QWEN_MODEL=qwen/qwen3.7-flash
QWEN_TIMEOUT_SECONDS=90
INVOICE_MAX_BYTES=10485760
INVOICE_MAX_PDF_PAGES=5
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@example.com
SCHEDULER_ENABLED=true
REMINDER_POLL_SECONDS=30
REMINDER_MAX_ATTEMPTS=5
REMINDER_RETRY_MINUTES=5
